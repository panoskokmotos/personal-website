# PostHog analytics configuration for the CLI tools and dev scripts.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Get the project token from https://us.posthog.com/project/settings

POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
POSTHOG_HOST=https://us.i.posthog.com
# Optional: enable verbose PostHog client logging
# POSTHOG_DEBUG=True
